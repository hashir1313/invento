# Neon PostgreSQL Database Connection URL (Serverless Pooled Connection)
# Example: postgresql://username:password@ep-example-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/invento?sslmode=require"

# Vercel Blob Read/Write Token (Automatically populated when linked to Vercel Blob)
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_sample_token"

# Authentication Session Secret
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
