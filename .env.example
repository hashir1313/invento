# Neon PostgreSQL connection string (pooled) — use a dev branch locally, never production
DATABASE_URL="postgresql://user:password@ep-example.region.aws.neon.tech/invento?sslmode=require"

# Single-owner auth credentials (generate with: bun run create-user <username> <password>)
AUTH_USERNAME="admin"
AUTH_PASSWORD_HASH=""

# Session JWT signing secret (generate with: openssl rand -base64 32)
AUTH_SECRET=""

# Optional: Vercel Blob token (wired up on production setup; local dev uses compressed WebP data URLs)
BLOB_READ_WRITE_TOKEN=""
